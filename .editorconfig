# Android アプリ用 EditorConfig（Androidアプリ開発プロジェクト規約 §4.1）
# 各アプリの直下へ .editorconfig としてコピーする。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

# Markdown の行末スペース 2 個による改行を消さない
[*.md]
trim_trailing_whitespace = false

# Windows のバッチは CRLF（コーディング規約 M2）
[*.{bat,cmd}]
end_of_line = crlf

# PowerShell は UTF-8 BOM 付き・CRLF（コーディング規約 S3）
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
