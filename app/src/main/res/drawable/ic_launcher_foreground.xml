<?xml version="1.0" encoding="utf-8"?>
<!--
  A shopping cart with a plus, in white, like the Chrome extension's icon.
  Everything stays inside the adaptive icon's 66dp safe zone (centre 54,54).
  The legacy mipmap bitmaps are drawn from the same coordinates
  (docs/20260920_共有からTodoist登録/ の I6 の記録).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- handle -->
    <path
        android:fillColor="#00000000"
        android:pathData="M30,40L36,40L41.5,53"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />
    <!-- basket -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41.5,53L74,53L68,69L47.5,69Z"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />
    <!-- wheels -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47.5,76a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M60.5,76a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0Z" />
    <!-- plus -->
    <path
        android:fillColor="#00000000"
        android:pathData="M69,28.5L69,41.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M62.5,35L75.5,35"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
</vector>
