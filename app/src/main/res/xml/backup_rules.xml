<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup (API 30 and below). See
   https://developer.android.com/guide/topics/data/autobackup
   The settings DataStore holds the Todoist API token, encrypted with a key that
   never leaves this device (data/KeystoreTokenCipher). A restore on another
   device could not read it, and the token should not travel: keep the whole
   datastore folder out of backups (計画書 §7).
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
