<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-to-device transfer (API 31 and above). See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The settings DataStore holds the encrypted Todoist API token; the key stays in
   this device's Keystore, so it is excluded from both (計画書 §7).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
